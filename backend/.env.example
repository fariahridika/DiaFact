# Copy to .env and adjust. Never commit the real .env.

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Leave blank only for a local XAMPP demo. Required in production.
DB_PASS=
DB_NAME=diafact

# --- Services -------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
ML_URL=http://127.0.0.1:5001
ML_TIMEOUT_MS=60000

# --- Security -------------------------------------------------------------
# Comma-separated exact origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a long random string to require the x-api-key header on every /api call.
API_KEY=
RATE_LIMIT_PER_MIN=60
